{
  "name": "srv",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "package": "svelte-kit sync && svelte-package",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles/tailwind": "./dist/style.css",
    "./components/summa.svelte": {
      "types": "./dist/components/summa.svelte.d.ts",
      "svelte": "./dist/components/summa.svelte.js"
    },
    "./components/Stage.svelte": {
      "types": "./dist/components/Stage.svelte.d.ts",
      "svelte": "./dist/components/Stage.svelte"
    },
    "./components/options/schema": {
      "types": "./dist/components/options/schema.d.ts",
      "default": "./dist/components/options/schema.js"
    },
    "./components/options/OptionsMain.svelte": {
      "types": "./dist/components/options/OptionsMain.svelte.d.ts",
      "svelte": "./dist/components/options/OptionsMain.svelte"
    },
    "./components/options/state.svelte": {
      "types": "./dist/components/options/state.svelte.d.ts",
      "svelte": "./dist/components/options/state.svelte.js"
    },
    "./components/popup/PopupMain.svelte": {
      "types": "./dist/components/popup/PopupMain.svelte.d.ts",
      "svelte": "./dist/components/popup/PopupMain.svelte"
    },
    "./server/stream.helper": {
      "types": "./dist/server/stream.helper.d.ts",
      "default": "./dist/server/stream.helper.js"
    },
    "./shared/common.util": {
      "types": "./dist/share/common.util.d.ts",
      "default": "./dist/shared/common.util.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@internationalized/date": "^3.12.1",
    "@lucide/svelte": "^1.14.0",
    "@sveltejs/adapter-node": "5.5.4",
    "@sveltejs/package": "2.5.7",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^25.9.0",
    "@vitest/browser-playwright": "^4.1.6",
    "bits-ui": "2.18.1",
    "dotenv": "17.4.2",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.17.1",
    "globals": "^17.6.0",
    "partial-json": "0.1.7",
    "playwright": "^1.60.0",
    "prettier-plugin-svelte": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "sass-embedded": "1.99.0",
    "svelte-check": "^4.4.8",
    "svelte-exmarkdown": "5.0.2",
    "tailwindcss": "^4.2.4",
    "tailwindcss-animate": "1.0.7",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6",
    "vitest-browser-svelte": "^2.1.1"
  },
  "dependencies": {
    "@tanstack/svelte-form": "1.32.0",
    "ky": "2.0.2",
    "valibot": "^1.1.0"
  },
  "peerDependencies": {
    "svelte": "^5.55.5"
  }
}
